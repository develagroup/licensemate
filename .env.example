# Email OTP is restricted to mistervela@gmail.com.
# On the license server, local Postfix can send mail without SMTP credentials.
SMTP_HOST="mail.develadigital.com"
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="LicensePulse <licensemate@develadigital.com>"
# Required for durable, encrypted license-key emails and retry support.
# Generate once with: openssl rand -hex 32. Keep stable and private across restarts.
EMAIL_OUTBOX_ENCRYPTION_KEY=""

# Generate a random 32+ character value; keep it private and stable between restarts.
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

PORT=3000
# Canonical browser origin, without a path or trailing slash. Required in production.
APP_ORIGIN="https://licensemate.develadigital.com"

# PostgreSQL runtime role: no DDL privileges; runtime grants are applied by
# `npm run db:migrate` using DATABASE_MIGRATION_URL. Never use VITE_* for secrets.
DATABASE_URL="postgresql://licensepulse_app:replace-me@127.0.0.1:55432/licensepulse"
# Separate role that owns/changes schema objects. Keep this credential out of
# the running app's environment in production; use it only for migrations.
DATABASE_MIGRATION_URL="postgresql://licensepulse_migrator:replace-me@127.0.0.1:55432/licensepulse"
DATABASE_RUNTIME_ROLE="licensepulse_app"
DB_CONNECTION_LIMIT=10
